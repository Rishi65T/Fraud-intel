# FRAUDINTEL Configuration
# NO MANDATORY EXTERNAL AI API KEYS REQUIRED (Runs 100% locally)

PYTHON_BACKEND_URL="http://127.0.0.1:8000"
PORT=3000

# Database Connections (PostgreSQL, Neo4j, Redis with automatic SQLite fallback)
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="fraudintel"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"

NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"

REDIS_HOST="localhost"
REDIS_PORT=6379

# Local RAG & Embedding Settings
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
OLLAMA_URL="http://localhost:11434"
